{
  "name": "lz77",
  "version": "2.0.0",
  "description": "A typescript implementation of lz77, usable for node and browsers.",
  "main": "dist/index.js",
  "module": "dist/lz77.es.js",
  "exports": {
    ".": {
      "import": "./dist/lz77.es.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "vite build",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "docs": "typedoc --out docs/ index.ts",
    "bench": "tsx bench.ts",
    "bench:save": "tsx bench.ts --json",
    "bench:compare": "tsx bench-compare.ts",
    "bench:ci": "tsx bench.ts --json --label ci"
  },
  "homepage": "http://whoughton.github.io/lz77/",
  "repository": {
    "type": "git",
    "url": "git@github.com:whoughton/lz77.git"
  },
  "keywords": [
    "Compression",
    "Data Transmission",
    "lz77",
    "lzw"
  ],
  "author": "Weston Houghton <whoughton@gmail.com>",
  "license": "BSD",
  "bugs": {
    "url": "https://github.com/whoughton/lz77/issues"
  },
  "type": "module",
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.9",
    "vitest": "^4.1.5"
  },
  "eslintConfig": {
    "rules": {
      "indent": [
        1,
        "tab",
        {
          "SwitchCase": 1
        }
      ],
      "quotes": [
        1,
        "single"
      ],
      "linebreak-style": [
        2,
        "unix"
      ],
      "semi": [
        2,
        "always"
      ],
      "no-console": [
        0
      ],
      "comma-style": [
        2,
        "first",
        {
          "exceptions": {
            "ArrayExpression": true,
            "ObjectExpression": true
          }
        }
      ]
    },
    "env": {
      "es6": true,
      "browser": true,
      "node": true
    },
    "globals": {
      "define": true
    },
    "extends": "eslint:recommended"
  },
  "types": "dist/index.d.ts"
}
